# Pinned FFmpeg binaries for WaxOnWaxOff (arm64 macOS).
# Audio-only LGPL build produced by scripts/build-ffmpeg.sh — no --enable-gpl,
# no --enable-nonfree, no --enable-version3; libmp3lame is the only external library.
# Update checksums and FFMPEG_DEPS_TAG when rebasing to a new build.
#
# REPRODUCIBLE: `./scripts/build-ffmpeg.sh <dir>` on the same toolchain rebuilds
# these byte for byte, so the checksums below are independently verifiable rather
# than merely asserted.
#
# The deps release MUST stay flagged as a prerelease. README.md and docs/index.html
# link to /releases/latest/download/, and an ordinary release here becomes "latest"
# and 404s that link.
#
# r4 keeps LC_UUID. r2 dropped it for reproducibility, and dyld on macOS 26.7
# refuses to load an executable without one, so every r2 binary aborts there;
# r4 gets reproducibility from ZERO_AR_DATE instead. Built with Xcode 27.
# The suffix is the recipe revision. r5 adds --disable-decoder to LAME's
# configure (from 3.101 it links a Homebrew libmpg123 whenever one is
# installed) and pins FFmpeg 9.0.2 and LAME 4.0. The 8.0 line had gone quiet,
# and 9.0 changes AAC decoding slightly: see the deps release for the parity
# numbers the owner accepted on 2026-09-24.
#
# Superseded pins must NOT be deleted — each is what older tags verify against,
# and removing one makes those tags unbuildable from a clean checkout:
#   ffmpeg-deps-8.0-audio-arm64      this repo           v2.4.0 – v2.11.0
#   ffmpeg-deps-8.0-audio-arm64-r2   this repo           v2.11.1 – v2.12.1
#   ffmpeg-deps-8.0-audio-arm64-r3   ClipHack-releases   v2.12.2
#   ffmpeg-deps-8.0-audio-arm64-r4   this repo           v2.12.3 – v2.12.4
#   ffmpeg-deps-8.0.3-audio-arm64-r4 this repo           v2.12.5
# The first is behaviourally identical to r2; it came from the same recipe before
# that pinned the build directory and dropped LC_UUID. v2.12.2 borrowed
# ClipHack's r3 during the 2026-09-16 migration, before this repo had a build
# with LC_UUID of its own; r4 brings the pin home. There is no r3 here.
FFMPEG_VERSION=9.0.2
FFMPEG_ARCH=arm64
FFMPEG_DEPS_REPO=sevmorris/WaxOnWaxOff
FFMPEG_DEPS_TAG=ffmpeg-deps-9.0.2-audio-arm64-r5
FFMPEG_SHA256=4f6cb3c1b8d4e1309ee520c04ba4f3c875ba5f0aa359270ba318271fe3dc7daf
FFPROBE_SHA256=f2ff2ae3dbd4a5718594abecc1c59dacfb2755ac1765b3e6329b895446198ff9

# Corresponding upstream source (LGPL §6) — see Vendor/README.md
FFMPEG_SOURCE_RELEASE=9.0.2
FFMPEG_SOURCE_RELEASE_DATE=2026-09-17
FFMPEG_SOURCE_ARCHIVE=ffmpeg-9.0.2.tar.xz
FFMPEG_SOURCE_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SOURCE_SIGNATURE_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz.asc
FFMPEG_SOURCE_GIT_TAG=n9.0.2

# Statically linked LGPL dependency, built from source by scripts/build-ffmpeg.sh
LAME_VERSION=4.0
LAME_SOURCE_URL=https://downloads.sourceforge.net/project/lame/lame/4.0/lame-4.0.tar.gz

# Superseded GPL build (x264/x265/libvidstab), shipped through app v2.3.0.
# Withdrawn from distribution — compliant Corresponding Source could not be
# obtained, so the release assets were removed and no source directions exist.
# See "Historical builds" in Vendor/README.md. Recorded here for provenance
# only; no script reads this value.
FFMPEG_DEPS_TAG_SUPERSEDED=ffmpeg-deps-8.0-arm64
